{
  "name": "vertex-engine",
  "version": "1.1.0",
  "description": "A vector-native, agent-first game format and engine. Everything is SVG paths and JSON; a whole game fits in a link.",
  "type": "module",
  "main": "src/index.js",
  "types": "types/index.d.ts",
  "bin": { "vertex": "bin/vertex.js" },
  "exports": {
    ".": { "types": "./types/index.d.ts", "default": "./src/index.js" },
    "./node": { "types": "./types/index.d.ts", "default": "./src/node.js" },
    "./mcp": "./mcp/server.js"
  },
  "files": ["src", "bin", "mcp", "schema", "types", "play.html", "SPEC.md", "conformance", "py"],
  "scripts": {
    "test": "node --test",
    "play:agent": "node examples/drift/agent-play.js",
    "replay": "node bin/vertex.js play examples/drift/drift-run.json",
    "mcp": "node bin/vertex.js mcp",
    "bench": "node bench/bench.js",
    "conform": "python py/vertex.py conform",
    "test:browser": "node tools/browser/run.mjs",
    "serve": "npx --yes serve ."
  },
  "engines": { "node": ">=20.11" },
  "keywords": ["game-engine", "vector", "svg", "agents", "llm", "mcp", "canvas", "png", "replay", "deterministic", "2d"],
  "license": "MIT"
}
