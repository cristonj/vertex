{
  "vertex": 1,
  "title": "Starfall",
  "description": "Catch falling stars, dodge the shards. A complete game in one JSON file: art, scene, rules, keys.",
  "width": 480, "height": 360, "background": "#0d0b1a",
  "shapes": {
    "cup": { "parts": [
      { "d": "M-26 -6 L-18 8 L18 8 L26 -6", "stroke": "#7df9ff", "width": 3 },
      { "d": "M-14 8 L-10 12 L10 12 L14 8", "stroke": "#3aa6b9", "width": 2 }
    ] },
    "star": { "d": "M0 -10 L2.9 -4 L9.5 -3.1 L4.8 1.5 L5.9 8.1 L0 5 L-5.9 8.1 L-4.8 1.5 L-9.5 -3.1 L-2.9 -4 Z", "fill": "#ffd166" },
    "shard": { "d": "M0 -12 L6 0 L0 12 L-6 0 Z", "fill": "none", "stroke": "#ff5d73", "width": 2 },
    "spark": { "d": "M-2 0 L2 0 M0 -2 L0 2", "stroke": "#ffd166", "width": 1.5 }
  },
  "entities": [
    { "id": "player", "shape": "cup", "x": 240, "y": 330, "tags": ["player"] }
  ],
  "sounds": {
    "ding": { "wave": "triangle", "freq": 880, "slide": 900, "decay": 0.15, "volume": 0.3 },
    "crack": { "wave": "noise", "freq": 1500, "slide": -1200, "decay": 0.3, "volume": 0.4 }
  },
  "state": { "score": 0, "lives": 3, "speed": 90, "spawnEvery": 40, "timer": 0, "over": false, "hud": "" },
  "keys": { "ArrowLeft": "left", "ArrowRight": "right", "a": "left", "d": "right" },
  "systems": ["motion", "lifetime", { "collide": [["player", "star"], ["player", "shard"]] }, "rules"],
  "rules": [
    { "each": "player", "when": "!state.over && held('left')", "do": "self.x = max(26, self.x - 260 * dt)" },
    { "each": "player", "when": "!state.over && held('right')", "do": "self.x = min(W - 26, self.x + 260 * dt)" },

    { "when": "!state.over", "do": [
      "state.timer += 1",
      "if (state.timer >= state.spawnEvery) { state.timer = 0; let kind = random() < 0.7 ? 'star' : 'shard'; spawn(kind, {x: rand(20, W - 20), y: -12, vy: state.speed * rand(0.8, 1.3), vr: rand(-2, 2), tags: [kind, 'falling']}) }",
      "state.speed += 2 * dt",
      "state.spawnEvery = max(12, 40 - floor(state.score / 5))"
    ] },

    { "each": "falling", "when": "self.y > H + 20", "do": "despawn(self)" },

    { "on": "hit", "tags": ["player", "star"], "do": [
      "despawn(b); state.score += 1; sound('ding')",
      "spawn('spark', {x: b.x, y: b.y, vx: -40, vy: -60, data: {ttl: 0.3}})",
      "spawn('spark', {x: b.x, y: b.y, vx: 40, vy: -60, data: {ttl: 0.3}})"
    ] },
    { "on": "hit", "tags": ["player", "shard"], "do": [
      "despawn(b); state.lives -= 1; sound('crack')",
      "if (state.lives <= 0) { state.over = true; emit('gameover', {score: state.score}) }"
    ] },

    { "do": "state.hud = state.over ? 'GAME OVER  SCORE ' + str(state.score) : 'SCORE ' + str(state.score) + '  LIVES ' + str(state.lives)" }
  ]
}
